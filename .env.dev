# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

VERCEL_PRJ_ID=

# VERCEL POSTGRES -> dev is docker
# refs: https://vercel.com/ishiyus-projects/sveltekit-template/stores
POSTGRES_URL="postgres://postgres:password@0.0.0.0:5432/mydb?schema=public"
POSTGRES_PRISMA_URL="postgres://postgres:password@0.0.0.0:5432/mydb?schema=public"
POSTGRES_URL_NO_SSL="postgres://postgres:password@0.0.0.0:5432/mydb"
POSTGRES_URL_NON_POOLING="postgres://postgres:password@0.0.0.0:5432/mydb?schema=public"
POSTGRES_HOST="0.0.0.0"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DATABASE="mydb"

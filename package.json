{
  "name": "sveltekit-template",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.4.0",
  "scripts": {
    "build": "prisma generate && prisma db push && vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "dev": "vite dev",
    "dev:migrate": "prisma migrate dev",
    "test": "pnpm test:migrate && dotenv -e .env.test -- vitest",
    "test:migrate": "dotenv -e .env.test -- prisma migrate reset -f",
    "test:coverage": "prisma migrate reset -f && vitest run --coverage",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@sveltejs/adapter-vercel": "^5.4.1",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/svelte": "^5.2.0",
    "@vitest/coverage-v8": "^1.6.0",
    "dotenv-cli": "^7.4.2",
    "happy-dom": "^14.12.3",
    "lefthook": "^1.6.21",
    "prisma": "^5.16.1",
    "svelte": "^4.2.7",
    "svelte-check": "^3.8.4",
    "tslib": "^2.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "dependencies": {
    "@prisma/client": "5.16.0",
    "@vercel/speed-insights": "^1.0.12",
    "ky": "^1.4.0",
    "valibot": "^0.35.0"
  }
}
